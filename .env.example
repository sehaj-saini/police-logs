# Local lab run: copy the supplied CSV to data/police_log.csv.
DATA_SOURCE=csv
CSV_PATH=data/police_log.csv
SOCRATA_APP_TOKEN=

# Replace these example values before starting the stack.
POSTGRES_USER=cpd_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=cpd_db

# These are defaults for Python/Jupyter running on the Windows host.
DB_HOST=localhost
DB_PORT=5433

# The scheduled daily run uses Cambridge local time.
PREFECT_CRON=0 0 * * *
PREFECT_TIMEZONE=America/New_York

# Required only for the cloud profile. Set this to a DNS name you control.
DASHBOARD_DOMAIN=crime.example.com
